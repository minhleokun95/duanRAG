# Doi ten file nay thanh .env roi dien thong tin. De trong LLM_API_KEY thi app van chay o che do "chi truy xuat".

# --- Cach A: Google Gemini (co goi mien phi) - lay key tai https://aistudio.google.com/apikey ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# --- Cach B: Ollama chay tren may (mien phi, can cai Ollama + tai model) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
